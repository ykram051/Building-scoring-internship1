# Docker ignore file for security
# Prevent sensitive files from being copied to Docker image

# Secrets and environment files
.env
.env.*
**/.env
**/.env.*
.streamlit/secrets.toml
**/.streamlit/secrets.toml

# Logs with potentially sensitive data
logs/
**logs/
*.log

# Database files
*.db
*.sqlite
*.sqlite3

# Temporary and cache files
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
.Python
*.so
.cache/
.pytest_cache/
**/.pytest_cache/

# User uploads (may contain sensitive data)
data/user_uploads/
**/user_uploads/
data/temp/
**/temp/

# Development files
.git/
.gitignore
.vscode/
.idea/
*.swp
*.swo
*~

# Documentation and development
README.md
docs/
tests/
test_*.py
*_test.py

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Build artifacts
build/
dist/
*.egg-info/

# Security scan results
.bandit
.safety

# Backup files
*.bak
*.backup
*.orig
